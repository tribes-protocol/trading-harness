{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  // Workspace-aware since the monorepo split. The Pi surface (`.pi/extensions`)
  // stays on the ROOT workspace because Pi discovers project extensions at
  // `join(cwd, '.pi', 'extensions')` with no ancestor walk — it cannot move into
  // a package. Everything else is declared against the workspace that owns it.
  "workspaces": {
    ".": {
      "entry": [".pi/extensions/*/index.ts", ".pi/extensions/tribes/AgentProxyToken.ts"],
      "project": [".pi/extensions/**/*.ts"]
    },
    "apps/cli": {
      "entry": ["src/cli/*.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "apps/gateway": {
      "entry": ["src/Main.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/protocol": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
