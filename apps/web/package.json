{
  "name": "@tribes-harness/web",
  "version": "0.1.0",
  "description": "Pi screen canvas on the left, main chat on the right",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -H 127.0.0.1 -p 3100",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3100",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0 --no-warn-ignored",
    "lint:fix": "eslint . --fix --max-warnings 0 --no-warn-ignored"
  },
  "dependencies": {
    "@tribes-harness/protocol": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.536.0",
    "next": "15.5.9",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "react-markdown": "9.0.3",
    "react-resizable-panels": "3.0.6",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.0",
    "tailwind-merge": "3.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "jsdom": "29.0.2",
    "tailwindcss": "4.2.2",
    "tw-animate-css": "1.3.6"
  }
}
