{
  // `@/*` resolves against TWO roots, in order. `packages/protocol` is a SOURCE
  // package whose own files import each other as `@/types/...`; TypeScript resolves
  // those specifiers with the tsconfig of the project that PULLS THEM IN, not with
  // the protocol package's own tsconfig. Without the second root, every
  // `@tribes-harness/protocol/*` import fails on the protocol's internal aliases.
  // Local `src/*` wins where both exist, so nothing here can be shadowed by the
  // protocol package.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowJs": true,
    "isolatedModules": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*", "../../packages/protocol/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "next.config.ts",
    "vitest.config.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
