{
  "name": "trading-harness",
  "version": "1.0.0",
  "description": "Autonomous Hyperliquid trading harness for Pi, plus the gateway and web UI that stream a Pi screen to the browser",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "TURBO_UI=0 turbo run typecheck --output-logs=full && tsc --noEmit -p tsconfig.json",
    "build": "TURBO_UI=0 turbo run build --output-logs=full",
    "dev": "TURBO_UI=0 turbo run dev --filter=@tribes-harness/gateway... --output-logs=full",
    "dev:cli": "sh scripts/dev.sh",
    "setup:dev": "sh scripts/setup-env.sh dev",
    "setup:prod": "sh scripts/setup-env.sh prod",
    "skills:upgrade": "bun scripts/skills-upgrade.mjs",
    "test:skills-release": "bun test/skills-release-verify.test.mjs",
    "test": "bun run typecheck",
    "test:unit": "TURBO_UI=0 turbo run test:unit --output-logs=full",
    "lint": "TURBO_UI=0 turbo run lint --output-logs=full && eslint .pi --max-warnings 0 --no-warn-ignored",
    "lint:fix": "TURBO_UI=0 turbo run lint:fix --output-logs=full && eslint .pi --fix --max-warnings 0 --no-warn-ignored && bun run format",
    "format": "prettier --write \"**/*.{ts,tsx,mts,md,json,jsonc,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,md,json,jsonc,yml,yaml}\"",
    "knip": "knip"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.3",
    "@earendil-works/pi-tui": "0.80.3",
    "@eslint/js": "9.39.3",
    "@types/node": "20.17.6",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "@typescript-eslint/utils": "8.56.1",
    "@vitest/coverage-v8": "4.1.3",
    "eslint": "9.39.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.3",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "knip": "5.44.0",
    "prettier": "3.3.3",
    "turbo": "2.10.0",
    "typescript": "5.8.3",
    "vitest": "4.1.3"
  }
}
